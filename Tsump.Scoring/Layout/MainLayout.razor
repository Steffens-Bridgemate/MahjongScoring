@inherits LayoutComponentBase
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

@* Global tab bar so Scores / Calculator are reachable from every page — including the QR
   deep-link /score page (the demo launches straight there). Scores is active everywhere except
   the calculator route. *@
<div class="page">
    <ul class="nav nav-tabs px-2 pt-2">
        <li class="nav-item">
            <a class="nav-link @(IsCalculator ? "" : "active")" href="">
                <i class="bi bi-card-checklist me-1"></i>@Lang.Get("Scores")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(IsCalculator ? "active" : "")" href="calculator">
                <i class="bi bi-calculator me-1"></i>@Lang.Get("RiichiCalculator")
            </a>
        </li>
    </ul>
    <main class="container py-2">
        @Body
    </main>
</div>

@code {
    private bool IsCalculator =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').StartsWith("calculator", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Lang.OnLanguageChanged -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
