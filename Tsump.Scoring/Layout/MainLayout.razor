@inherits LayoutComponentBase
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

@* Global Scores / Calculator tab strip. The tabs DO NOT navigate — switching only flips which view
   is visible (CSS), so the routed page (@Body, e.g. the /score entry table) stays mounted and its
   in-progress, not-yet-saved score entry is never lost. Both views are kept in the DOM; only their
   visibility toggles. A real navigation (e.g. opening a new QR score link) resets to the Scores view. *@
<div class="page">
    <ul class="nav nav-tabs px-2 pt-2">
        <li class="nav-item">
            <button type="button" class="nav-link @(showCalculator ? "" : "active")"
                    @onclick="() => showCalculator = false">
                <i class="bi bi-card-checklist me-1"></i>@Lang.Get("Scores")
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(showCalculator ? "active" : "")"
                    @onclick="() => showCalculator = true">
                <i class="bi bi-calculator me-1"></i>@Lang.Get("RiichiCalculator")
            </button>
        </li>
    </ul>
    <main class="container py-2">
        <div class="@(showCalculator ? "d-none" : null)">
            @Body
        </div>
        <div class="@(showCalculator ? null : "d-none")">
            <RiichiScoreCalculator />
            <div class="mt-4">
                <a class="btn btn-outline-primary" href="@StandaloneUrl" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right me-1"></i>@Lang.Get("RiichiInstallStandalone")
                </a>
            </div>
        </div>
    </main>
</div>

@code {
    private bool showCalculator;

    // Standalone calculator PWA (separate repo, GitHub Pages).
    private const string StandaloneUrl = "https://steffens-bridgemate.github.io/MahjongRiichiCalc/";

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    // A genuine navigation (new score deep-link) should land on the Scores view, not the calculator.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        showCalculator = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
